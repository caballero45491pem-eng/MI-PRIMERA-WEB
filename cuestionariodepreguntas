:root {
    --primary: #4a6fa5;
    --secondary: #166088;
    --success: #2ec4b6;
    --danger: #e71d36;
    --light: #f6f8fa;
    --dark: #011627;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--light);
    color: var(--dark);
    margin: 0;
    padding: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.quiz-container {
    background-color: white;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    width: 100%;
    max-width: 600px;
    padding: 30px;
    box-sizing: border-box;
    position: relative;
}

h1 {
    text-align: center;
    color: var(--secondary);
    margin-top: 0;
}

.welcome-text {
    text-align: center; 
    color: #555;
}

.input-group {
    margin-bottom: 20px;
}

.input-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
}

.input-group input {
    width: 100%;
    padding: 10px;
    border: 2px solid #ccc;
    border-radius: 6px;
    font-size: 16px;
    box-sizing: border-box;
}

.header-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--light);
}

.timer-box {
    display: flex;
    align-items: center;
    font-size: 18px;
    font-weight: bold;
    color: var(--danger);
}

.timer-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    fill: var(--danger);
}

.progress {
    font-size: 16px;
    color: #666;
}

.question {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 20px;
}

.options-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.option-btn {
    background-color: var(--light);
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    padding: 14px;
    font-size: 16px;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
}

.option-btn:hover {
    background-color: #edf2f7;
    border-color: var(--primary);
}

.option-btn.selected {
    background-color: var(--primary);
    color: white;
    border-color: var(--secondary);
}

.controls {
    margin-top: 25px;
    display: flex;
    justify-content: flex-end;
}

button.action-btn {
    background-color: var(--secondary);
    color: white;
    border: none;
    padding: 12px 24px;
    font-size: 16px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    transition: background-color 0.2s;
}

button.action-btn:hover {
    background-color: var(--primary);
}

/* Estilo específico para el botón de enviar correo institucional */
#send-email-btn {
    background-color: var(--success) !important;
    color: white;
    width: 100%;
    max-width: 400px;
    margin-top: 10px;
    padding: 14px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    border: none;
    cursor: pointer;
    transition: filter 0.2s;
}

#send-email-btn:hover {
    filter: brightness(0.9);
}

.hidden {
    display: none !important;
}

.results-container {
    text-align: center;
}

.score {
    font-size: 48px;
    font-weight: bold;
    color: var(--secondary);
    margin: 20px 0;
}

.feedback-message {
    font-size: 18px;
    margin-bottom: 30px;
    padding: 15px;
    border-radius: 8px;
    font-weight: 500;
}

.fb-low { background-color: #ffe5ec; color: var(--danger); }
.fb-mid { background-color: #fefae0; color: #b7b7a4; }
.fb-high { background-color: #e8f5e9; color: #2e7d32; }

/* Estilo dinámico adaptativo para los estados de EmailJS */
.mail-status-text {
    font-size: 15px;
    font-weight: bold;
    font-style: italic; 
    color: #666; 
    margin: 15px 0;
    padding: 8px;
    transition: color 0.3s ease;
}

.btn-group {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 20px;
}

.restart-btn {
    background-color: var(--primary) !important;
}

/* Oculta los componentes no deseados al momento de imprimir */
@media print {
    body { background: white; color: black; padding: 0; }
    .quiz-container { box-shadow: none; max-width: 100%; padding: 0; }
    .btn-group, .timer-box, #send-email-btn, .mail-status-text { display: none !important; }
    .results-container { margin-top: 50px; }
}

// Banco de 10 preguntas sobre números enteros (cada una vale 2 puntos)
const questions = [
    { q: "¿Cuánto es -5 + (-3)?", options: ["-2", "2", "-8", "8"], correct: 2 },
    { q: "¿Cuál es el resultado de 8 - (-4)?", options: ["4", "12", "-12", "-4"], correct: 1 },
    { q: "Resuelve: (-6) × 3", options: ["-18", "18", "-3", "-9"], correct: 0 },
    { q: "Resuelve: (-20) ÷ (-4)", options: ["-5", "5", "16", "-16"], correct: 1 },
    { q: "¿Cuál es el valor absoluto de -15?", options: ["-15", "0", "15", "1"], correct: 2 },
    { q: "Si el termómetro marca -2°C y la temperatura baja 5°C más, ¿cuánto marca ahora?", options: ["3°C", "-7°C", "7°C", "-3°C"], correct: 1 },
    { q: "Ordena de menor a mayor: -7, 2, -3, 0", options: ["-7, -3, 0, 2", "0, 2, -3, -7", "-3, -7, 0, 2", "-7, 0, -3, 2"], correct: 0 },
    { q: "¿Qué número entero representa una deuda de 500 dólares?", options: ["500", "+500", "-500", "0"], correct: 2 },
    { q: "Calcula el resultado de: -10 + 15 - 3", options: ["2", "-2", "8", "5"], correct: 0 },
    { q: "¿Cuál es el opuesto del número -9?", options: ["-9", "9", "0", "1/9"], correct: 1 }
];

let currentQuestionIndex = 0;
let score = 0;
let studentName = "";
let selectedOption = null;
let timerInterval = null;
let timeLeft = 60; 
let currentFeedbackText = ""; 

function startQuiz() {
    const nameInput = document.getElementById("student-name").value.trim();
    if (!nameInput) {
        alert("Por favor, introduce tu nombre para empezar.");
        return;
    }
    studentName = nameInput;
    document.getElementById("start-screen").classList.add("hidden");
    document.getElementById("quiz-screen").classList.remove("hidden");
    
    currentQuestionIndex = 0;
    score = 0;
    document.getElementById("next-btn").innerText = "Siguiente";
    
    loadQuestion();
}

function loadQuestion() {
    clearInterval(timerInterval);
    timeLeft = 60;
    document.getElementById("timer-count").innerText = timeLeft;
    selectedOption = null;

    if (currentQuestionIndex === questions.length - 1) {
        document.getElementById("next-btn").innerText = "Terminar Examen";
    } else {
        document.getElementById("next-btn").innerText = "Siguiente";
    }

    timerInterval = setInterval(() => {
        timeLeft--;
        document.getElementById("timer-count").innerText = timeLeft;
        if (timeLeft <= 0) {
            clearInterval(timerInterval);
            alert("¡Tiempo agotado en esta pregunta!");
            nextQuestion(); 
        }
    }, 1000);

    const currentQ = questions[currentQuestionIndex];
    document.getElementById("current-q-num").innerText = currentQuestionIndex + 1;
    document.getElementById("question-text").innerText = currentQ.q;

    const optionsBox = document.getElementById("options-box");
    optionsBox.innerHTML = "";

    currentQ.options.forEach((option, index) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.innerText = option;
        btn.onclick = () => selectOption(index, btn);
        optionsBox.appendChild(btn);
    });
}

function selectOption(index, btnElement) {
    selectedOption = index;
    const buttons = document.querySelectorAll(".option-btn");
    buttons.forEach(b => b.classList.remove("selected"));
    btnElement.classList.add("selected");
}

function nextQuestion() {
    if (selectedOption === null && timeLeft > 0) {
        alert("Por favor, selecciona una respuesta antes de continuar.");
        return;
    }

    if (selectedOption === questions[currentQuestionIndex].correct) {
        score += 2;
    }

    currentQuestionIndex++;

    if (currentQuestionIndex < questions.length) {
        loadQuestion();
    } else {
        clearInterval(timerInterval);
        showResults();
    }
}

function showResults() {
    document.getElementById("quiz-screen").classList.add("hidden");
    document.getElementById("results-screen").classList.remove("hidden");
    
    document.getElementById("res-student-name").innerText = studentName;
    document.getElementById("final-score").innerText = `${score} / 20`;

    const feedbackBox = document.getElementById("feedback-box");

    if (score >= 0 && score <= 10) {
        currentFeedbackText = "Necesitas reforzamiento. Por favor, vuelve a repetir el quiz para mejorar tus habilidades.";
        feedbackBox.className = "feedback-message fb-low";
    } else if (score >= 11 && score <= 15) {
        currentFeedbackText = "¡Lo lograste! Pero aún necesitas reforzamiento en algunos conceptos clave.";
        feedbackBox.className = "feedback-message fb-mid";
    } else if (score >= 16 && score <= 20) {
        currentFeedbackText = "¡Excelente! Lograste un buen puntaje. Demuestras un gran dominio de los números enteros.";
        feedbackBox.className = "feedback-message fb-high";
    }

    feedbackBox.innerText = currentFeedbackText;
}

function triggerEmailSend() {
    sendEmailReport(currentFeedbackText);
}

function sendEmailReport(feedbackText) {
    const statusLabel = document.getElementById("mail-status");
    statusLabel.innerText = "Conectando con el servidor de correo...";
    statusLabel.style.color = "#166088";

    const payload = {
        service_id: 'service_evjpw3k',
        template_id: 'template_kw7nv8s',
        user_id: '9YDb8V8aHFA03Ffjv',
        template_params: {
            to_email: "caballero.45491pem@uprit.edu.pe",
            student_name: studentName,
            final_score: `${score} / 20`,
            feedback: feedbackText
        }
    };

    // DIRECCIÓN CORREGIDA: Apunta exactamente a la API de envío de EmailJS
    fetch('https://emailjs.com', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload),
        mode: 'no-cors' 
    })
    .then(() => {
        statusLabel.innerText = "¡Nota enviada exitosamente a caballero.45491pem@uprit.edu.pe!";
        statusLabel.style.color = "green";
        alert("Los resultados han sido procesados y enviados al correo del docente.");
    })
    .catch((error) => {
        console.error("Error:", error);
        statusLabel.innerText = "Error al intentar despachar el correo.";
        statusLabel.style.color = "red";
    });
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz de Números Enteros</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <div class="quiz-container">
        <!-- PANTALLA 1: REGISTRO DE ESTUDIANTE -->
        <div id="start-screen">
            <h1>Evaluación de Números Enteros</h1>
            <p class="welcome-text">Por favor, ingresa tus datos antes de comenzar el examen. Tienes 60 segundos por pregunta.</p>
            <div class="input-group">
                <label for="student-name">Nombre Completo del Alumno:</label>
                <input type="text" id="student-name" placeholder="Ej. Juan Pérez" required>
            </div>
            <div class="controls">
                <button class="action-btn" onclick="startQuiz()">Comenzar Examen</button>
            </div>
        </div>

        <!-- PANTALLA 2: JUEGO DE PREGUNTAS -->
        <div id="quiz-screen" class="hidden">
            <div class="header-info">
                <div class="progress">Pregunta: <span id="current-q-num">1</span> / 10</div>
                <div class="timer-box">
                    <svg class="timer-icon" viewBox="0 0 24 24">
                        <path d="M12 20c4.42 0 8-3.58 8-8s-3-8-8-8-8 3.58-8 8 3.58 8 8 8zm0-18c5.52 0 10 4.48 10 10s-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2zm1 5h-2v6h5v-2h-3V7z"/>
                    </svg>
                    <span id="timer-count">60</span>s
                </div>
            </div>

            <div class="question" id="question-text">Texto de la pregunta</div>
            <div class="options-container" id="options-box"></div>

            <div class="controls">
                <button class="action-btn" id="next-btn" onclick="nextQuestion()">Siguiente</button>
            </div>
        </div>

        <!-- PANTALLA 3: RESULTADOS -->
        <div id="results-screen" class="hidden">
            <div class="results-container">
                <h1>Resultados de la Evaluación</h1>
                <p><strong>Estudiante:</strong> <span id="res-student-name"></span></p>
                <p>Has finalizado el banco de 10 preguntas sobre Números Enteros.</p>
                
                <div class="score" id="final-score">00 / 20</div>
                <div id="feedback-box" class="feedback-message"></div>

                <p id="mail-status" class="mail-status-text">Resultados listos para ser enviados.</p>

                <div class="btn-group" style="display: flex; flex-direction: column; gap: 12px; align-items: center;">
                    <!-- Botón enlazado con la acción de envío -->
                    <button class="action-btn" id="send-email-btn" onclick="triggerEmailSend()">
                        ✉️ Enviar resultados a caballero.45491pem@uprit.edu.pe
                    </button>
                    
                    <div style="display: flex; gap: 15px; justify-content: center; width: 100%;">
                        <button class="action-btn" onclick="window.print()">Imprimir Nota / Guardar PDF</button>
                        <button class="action-btn restart-btn" onclick="location.reload()">Reiniciar Examen</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
